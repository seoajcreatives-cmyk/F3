---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import Reviews from '@components/Reviews.astro';
import { Image } from 'astro:assets';
import GoogleMap from '@components/GoogleMap.astro';
import Icon from '@components/Icon.astro';
import servicesData from '../../data/services.json';
import '../../styles/internal-services.css';
import '../../styles/landings.css';

const cleanMediaUrl = (url: string) => {
  if (!url) return '';
  return url.startsWith('/') ? url : '/' + url.replace(/^\.\//, '');
};

// Generar rutas estáticas para cada servicio en base al JSON unificado
export async function getStaticPaths() {
  return servicesData.map((service) => {
    return {
      params: { service: service.slug },
      props: { service },
    };
  });
}

const { service } = Astro.props;

// Cargar todas las imágenes de forma dinámica para optimizarlas en tiempo de build
const images = import.meta.glob<{ default: ImageMetadata }>('../../../public/media/**/*.{jpeg,jpg,png,gif,webp,svg}');

const cleanPath = (p: string) => {
  if (!p) return '';
  let normalized = p.replace(/^\.?\/?/, '');
  if (!normalized.startsWith('public/')) {
    if (!normalized.startsWith('media/')) {
      normalized = 'media/' + normalized;
    }
    normalized = '../../../public/' + normalized;
  } else {
    normalized = '../../../' + normalized;
  }
  return normalized;
};

const processImagePath = cleanPath(service.processImageSrc);
const whyImagePath = cleanPath(service.whyImageSrc);

const processImageObj = images[processImagePath] ? (await images[processImagePath]()).default : null;
const whyImageObj = images[whyImagePath] ? (await images[whyImagePath]()).default : null;

// Nuevos datos de Schema JSON-LD para las páginas de servicio
const serviceSchemasData = [
  {"slug":"basement-solutions-long-island-ny","serviceName":"Basement Solutions in Long Island, NY","serviceType":"Basement Waterproofing & Remodeling","author":"Michael R.","date":"2026-03-14","review":"Our basement in Ronkonkoma had recurring leaks every spring. F3 installed a full drainage system with a sump pump and then finished the space into a family room. It stayed completely dry all winter and looks amazing. Highly recommend their basement work."},
  {"slug":"kitchen-remodeling-long-island-ny","serviceName":"Kitchen Remodeling in Long Island, NY","serviceType":"Kitchen Renovation","author":"Sandra M.","date":"2026-01-22","review":"F3 remodeled our kitchen from top to bottom — new cabinets, quartz countertops, and layered lighting. Olman helped us pick the layout and the crew kept everything clean and on schedule. It is now our favorite room in the house."},
  {"slug":"bathroom-renovation-long-island-ny","serviceName":"Bathroom Renovation in Long Island, NY","serviceType":"Bathroom Remodeling","author":"Karen D.","date":"2025-11-08","review":"I recently had my bathroom renovated with a walk-in shower and new tile, and I could not be happier with the results. From start to finish the process was smooth and stress-free. The team was punctual, respectful of my home, and communicated clearly every step of the way."},
  {"slug":"trim-carpentry-services-long-island-ny","serviceName":"Trim Carpentry Services in Long Island, NY","serviceType":"Trim Carpentry","author":"James T.","date":"2026-04-02","review":"F3 installed new baseboards, casings, and wainscoting throughout our first floor. Every joint is coped perfectly, every nail hole filled, and the paint finish is flawless. True craftsmen who clearly take pride in the details."},
  {"slug":"crown-molding-long-island-ny","serviceName":"Crown Molding Installation in Long Island, NY","serviceType":"Crown Molding Installation","author":"Patricia L.","date":"2025-09-19","review":"We added layered crown molding to the living room and dining room. The corners are seamless and the crew brought samples so we could see each profile before deciding. It completely transformed the feel of the house."},
  {"slug":"siding-installation-long-island-ny","serviceName":"Siding Installation in Long Island, NY","serviceType":"Siding Installation","author":"Robert G.","date":"2025-10-27","review":"F3 replaced all the siding on our house in Brentwood. The crew worked fast, cleaned up every day, and the curb appeal difference is night and day. Fair pricing and honest communication throughout the project."},
  {"slug":"replacement-windows-long-island-ny","serviceName":"Replacement Windows in Long Island, NY","serviceType":"Window Replacement","author":"Denise W.","date":"2026-02-10","review":"F3 replaced fourteen windows in our home. They helped us choose a style and color that matched the house, finished the installation in two days with no mess, and our energy bills have already dropped. Very professional team."},
  {"slug":"door-installation-long-island-ny","serviceName":"Door Installation in Long Island, NY","serviceType":"Door Installation","author":"Anthony C.","date":"2025-08-15","review":"They installed a new front entry door and two sliding patio doors. Perfect fit, smooth operation, and they even redid the trim around each opening so everything looks factory-finished. Very happy with the work."},
  {"slug":"house-painting-long-island-ny","serviceName":"House Painting in Long Island, NY","serviceType":"Interior & Exterior Painting","author":"Laura B.","date":"2026-05-06","review":"F3 painted our entire first floor plus the exterior trim. Clean lines, no drips, and they protected all our furniture and floors. The house looks brand new and they finished right on schedule."},
  {"slug":"power-washing-long-island-ny","serviceName":"Power Washing in Long Island, NY","serviceType":"Power Washing","author":"Steven H.","date":"2025-07-30","review":"F3 power washed our siding, deck, and walkway after the remodel. Everything came out spotless — years of grime gone in one afternoon. Quick, affordable, and thorough."},
  {"slug":"garage-builder-long-island-ny","serviceName":"Garage Builders in Long Island, NY","serviceType":"Garage Construction","author":"Mark P.","date":"2025-12-03","review":"F3 built us a detached two-car garage from the ground up. They handled everything from permits to the final coat of paint. Solid construction, great communication, and they finished on schedule."},
  {"slug":"masonry-contractors-long-island-ny","serviceName":"Masonry Contractors in Long Island, NY","serviceType":"Masonry","author":"Carlos V.","date":"2026-06-11","review":"F3 built our new paver driveway, front steps, and a retaining wall. The stonework is beautiful and perfectly level, and they handled the drainage correctly so nothing pools. Neighbors keep asking who did the work."},
  {"slug":"deck-builders-long-island-ny","serviceName":"Deck Builders in Long Island, NY","serviceType":"Deck Construction","author":"Brian K.","date":"2025-09-02","review":"I highly recommend F3. They had to rebuild our cedar pool deck where the structure was failing. They did a great job making it structurally sound for years to come, and the finished deck looks fantastic."},
  {"slug":"portico-contractor-long-island-ny","serviceName":"Portico Contractor in Long Island, NY","serviceType":"Portico Construction","author":"Jennifer S.","date":"2026-04-28","review":"F3 designed and built a new front portico with columns and a pitched roof. It completely changed the entrance of our home. Quality materials, clean workmanship, and great attention to detail from start to finish."},
  {"slug":"tile-installation-service-long-island-ny","serviceName":"Tile Installation Service in Long Island, NY","serviceType":"Tile Installation","author":"Nicole F.","date":"2025-10-09","review":"F3 installed the tile for our kitchen backsplash and bathroom floor. Perfect alignment, clean grout lines, and the pattern layout was exactly what we asked for. They even finished ahead of schedule."},
  {"slug":"patio-contractor-long-island-ny","serviceName":"Paver Patio Installation in Long Island, NY","serviceType":"Patio Installation","author":"David A.","date":"2026-06-25","review":"F3 installed a paver patio around our pool with a built-in seating area. The design process was easy — they brought samples and laid out options with us. The result is stunning and we use it every weekend."},
  {"slug":"outdoor-structure-builder-long-island-ny","serviceName":"Outdoor Structure Builder in Long Island, NY","serviceType":"Outdoor Structure Building","author":"Mark P.","date":"2026-05-12","review":"F3 Construction designed and built our custom deck and portico in Central Islip. Exceptional quality, sturdy framing, and finished on time. Highly recommend for any outdoor structure build!"},
  {"slug":"interior-renovation-contractor-long-island-ny","serviceName":"Interior Renovation Contractor in Long Island, NY","serviceType":"Interior Renovation","author":"Sandra M.","date":"2026-04-18","review":"F3 handled our entire interior renovation including kitchen remodel and trim carpentry. Professional team, fantastic attention to detail, and seamless sequencing throughout."},
  {"slug":"exterior-improvement-contractor-long-island-ny","serviceName":"Exterior Improvement Contractor in Long Island, NY","serviceType":"Exterior Home Improvement","author":"Robert G.","date":"2026-03-22","review":"From new siding to window installation and painting, F3 completely transformed the outside of our home. Exceptional curb appeal and top-tier craftsmanship."}
];

const customSchemaData = serviceSchemasData.find(d => d.slug === service.slug);

// Construcción del Schema de Servicio
let serviceSchema;

if (customSchemaData) {
  serviceSchema = {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "@id": `https://f3constructionny.com/services/${customSchemaData.slug}/#localbusiness`,
    "name": "F3 Construction Corp",
    "image": "https://f3constructionny.com/_astro/logo.CvoXPzJr_Z3Cs5c.webp",
    "url": `https://f3constructionny.com/services/${customSchemaData.slug}/`,
    "telephone": "+1-631-278-8693",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "290 Earle St",
      "addressLocality": "Central Islip",
      "addressRegion": "NY",
      "postalCode": "11722",
      "addressCountry": "US"
    },
    "areaServed": { "@type": "Place", "name": "Long Island, NY" },
    "makesOffer": {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": customSchemaData.serviceName,
        "serviceType": customSchemaData.serviceType
      }
    },
    "review": {
      "@type": "Review",
      "author": { "@type": "Person", "name": customSchemaData.author },
      "datePublished": customSchemaData.date,
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1" },
      "reviewBody": customSchemaData.review
    }
  };
} else {
  serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `https://f3constructionny.com/services/${service.slug}#service`,
    "serviceType": service.infoTitle,
    "name": service.metaTitle,
    "description": service.metaDescription,
    "provider": {
      "@type": "HomeAndConstructionBusiness",
      "name": "F3 Construction Corp",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Earle St",
        "addressLocality": "Central Islip",
        "addressRegion": "NY",
        "postalCode": "11722",
        "addressCountry": "US"
      }
    },
    "areaServed": {
      "@type": "Place",
      "name": "Long Island, NY"
    },
    "image": "https://f3constructionny.com/media/webp/png/logo.webp"
  };
}

// Construcción del Schema de Preguntas Frecuentes
const faqSchema = service.faqs && service.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `https://f3constructionny.com/services/${service.slug}#faq`,
  "mainEntity": service.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
} : null;

// Construcción del Schema Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://f3constructionny.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": service.h1,
      "item": `https://f3constructionny.com/services/${service.slug}/`
    }
  ]
};


const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout 
  title={service.metaTitle} 
  description={service.metaDescription} 
  canonical={service.canonical}
>
  <!-- Inyección de fragmento head con schemas dinámicos por servicio -->
  <Fragment slot="head">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main>
    <!-- Banner de Servicios con Formulario -->
    <section class={`banner-services ${service.bannerClass}`}>
      <div class="banner-container banner-split">
        <!-- LEFT (Título y Llamada a Acción) -->
        <div class="banner-left">
          <h1 set:html={service.h1}></h1>
          <div class="banner-cta">
            <a href="tel:+16312788693" class="btn-banner"><span>Call Us Today</span></a>
          </div>
        </div>

        <!-- RIGHT (Formulario de Contacto rápido) -->
        <div class="banner-right">
          <form id="contact_form_id" class="form-tag" method="post" novalidate>
            <div class="request-ctn">
              <div class="title">
                <h2>CONNECT WITH US</h2>
              </div>

              <div class="form-ctn">
                <input type="text" placeholder="Name" id="name" name="name" required />
                <input type="text" placeholder="Last Name" id="lastName" name="lastName" required />
                <input type="text" placeholder="Phone" id="phone" name="phone" required />
                <input type="email" placeholder="Email" id="email" name="email" required />
                <input type="text" placeholder="Message" id="message" name="message" required />
              </div>

              <div class="privacy-row">
                <input type="checkbox" id="acept" name="accept" required />
                <label for="acept">
                  I have read and accept the <a id="privacy" href={base + "privacy"} target="_blank">Privacy Policy</a>.
                </label>
              </div>

              <!-- Google reCAPTCHA -->
              <div class="g-recaptcha" data-sitekey="6Lc2YOsrAAAAANLQTo2_5XtXZqgH0neFNyTRMAhU"></div>

              <div class="submit-btn">
                <button type="button" id="submit_button" class="btn-submit-gtm">SEND REQUEST</button>
              </div>

              <div class="notify_box">
                <div class="loader" id="load_form" style="display:none; margin: 10px auto;"></div>
                <div class="message_box" id="message_box"></div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Ruta de Navegación (Breadcrumbs) -->
    <Breadcrumb />

    <!-- Información General del Servicio -->
    <section class="info-services-section">
      <h2 set:html={service.infoTitle}></h2>
      {service.infoParagraphs.map(p => {
        const trimmed = p.trim();
        if (trimmed.startsWith('<h3') || trimmed.startsWith('<h2') || trimmed.startsWith('<h4')) {
          return <Fragment set:html={p} />;
        }
        return <p set:html={p}></p>;
      })}
      <div class="banner-cta">
        <a href={base + "contact"} class="btn-banner">{service.infoCtaText || "Free Quote Service"}</a>
      </div>
    </section>

    <!-- Explicación de Qué es el Servicio -->
    {service.whatIsTitle && service.whatIsParagraphs && service.whatIsParagraphs.length > 0 && (
      <section class="what-is-section">
        <div class="title-section">
          <h2 set:html={service.whatIsTitle}></h2>
        </div>
        <div class="text-section">
          {service.slug === 'patio-contractor-long-island-ny' ? (
            <>
              {service.whatIsParagraphs.slice(0, 1).map(p => <p set:html={p}></p>)}
              {service.whatIsList && (
                <div class="list" style="margin-top: 20px; margin-bottom: 20px;">
                  <ul>
                    {service.whatIsList.slice(0, Math.ceil(service.whatIsList.length / 2)).map(item => (
                      <li set:html={item}></li>
                    ))}
                  </ul>
                  <ul>
                    {service.whatIsList.slice(Math.ceil(service.whatIsList.length / 2)).map(item => (
                      <li set:html={item}></li>
                    ))}
                  </ul>
                </div>
              )}
              {service.whatIsParagraphs.slice(1).map(p => <p set:html={p}></p>)}
            </>
          ) : service.whatIsList && service.whatIsList.length > 0 ? (
            <>
              {service.whatIsParagraphs.slice(0, 2).map(p => <p set:html={p}></p>)}
              <ul style="margin: 20px 0; padding-left: 20px; list-style-type: disc;">
                {service.whatIsList.map(item => (
                  <li style="margin-bottom: 10px;" set:html={item}></li>
                ))}
              </ul>
              {service.whatIsParagraphs.slice(2).map(p => <p set:html={p}></p>)}
            </>
          ) : (
            service.whatIsParagraphs.map(p => <p set:html={p}></p>)
          )}
        </div>
      </section>
    )}

    <!-- Proceso del Servicio e Imágenes Optimizadas -->
    <section class="service-img-section">
      <h2 set:html={service.processTitle}></h2>
      {service.processParagraph && (
        service.processParagraph.trim().startsWith('<') ? (
          <Fragment set:html={service.processParagraph} />
        ) : (
          <p set:html={service.processParagraph}></p>
        )
      )}
      
      {processImageObj && (
        <Image 
          src={processImageObj} 
          alt="Process Image" 
          loading="lazy" 
          width={service.processImageWidth} 
          height={service.processImageHeight} 
          style="width: 100%; max-width: 1900px; height: 25vw; object-fit: cover; margin: 30px; display: block;" 
        />
      )}

      {service.processList && service.processList.length > 0 && (
        <div class="list">
          <ul>
            {service.processList.slice(0, Math.ceil(service.processList.length / 2)).map((item) => (
              <li>
                <strong set:html={item.title}></strong><br />
                <span set:html={item.text}></span>
              </li>
            ))}
          </ul>
          <ul>
            {service.processList.slice(Math.ceil(service.processList.length / 2)).map((item) => (
              <li>
                <strong set:html={item.title}></strong><br />
                <span set:html={item.text}></span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Comparaciones / Opciones del Servicio -->
      {(service.considerItems.length > 0 || service.optionsItems.length > 0) && (
        <div class="table-services">
          <div class="table-box">
            <h3>{service.considerTitle || `When Should You Consider ${service.whatIsTitle ? service.whatIsTitle.replace(/<[^>]*>/g, '') : 'This Service'}?`}</h3>
            {service.considerSubtitle && <p set:html={service.considerSubtitle}></p>}
            <ul>
              {service.considerItems.map(item => <li set:html={item}></li>)}
            </ul>
          </div>
          <div class="table-box">
            <h3>{service.optionsTitle || "Popular Featured Options in NY"}</h3>
            <ul>
              {service.optionsItems.map(item => <li set:html={item}></li>)}
            </ul>
          </div>
        </div>
      )}
    </section>

    <!-- Por Qué Elegir F3 Construction -->
    <section class="services-section">
      <div class="services-container">
        <div class="service-item">
          <div class="service-text">
            <h2 set:html={service.whyTitle}></h2>
            {service.whyParagraphs.map(p => <p set:html={p}></p>)}
          </div>
          <div class="service-media right">
            {whyImageObj && (
              <Image 
                src={whyImageObj} 
                alt="Service Media Image" 
                loading="lazy" 
                width={service.whyImageWidth} 
                height={service.whyImageHeight} 
                style="width: 100%; height: auto; display: block;" 
              />
            )}
          </div>
        </div>
        <div class="banner-cta">
          <a href={base + "contact"} class="btn-banner">{service.whyCtaText || "Free Quote Service"}</a>
        </div>
      </div>
    </section>

    {service.video && (
      <section class="video-presentation-section" style="padding: 40px 20px; text-align: center; background-color: #f9f9f9;">
        <div style="max-width: 800px; margin: 0 auto;">
          <h2 style="font-family: 'Poppins', sans-serif; font-weight: 700; color: #e52a32; margin-bottom: 10px; font-size: 2rem;" set:html={service.video.title}></h2>
          <p style="font-family: 'Poppins', sans-serif; font-weight: 100; color: #000; margin-bottom: 25px; font-size: 1.1rem; line-height: 1.4;" set:html={service.video.text}></p>
          <div class="video-wrapper" style="box-shadow: 0 10px 30px rgba(0,0,0,0.1); border-radius: 12px; overflow: hidden; line-height: 0; aspect-ratio: 16 / 9; background-color: #000; max-height: 450px;">
            <video controls poster={cleanMediaUrl(service.video.poster)} style="width: 100%; height: 100%; object-fit: cover; display: block;">
              <source src={cleanMediaUrl(service.video.src)} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </section>
    )}

    <!-- Testimonios Reutilizables de Astro -->
    <section class="testimonial-section">
      <h2>Testimonials</h2>
      <p style="text-align: center;">{service.reviewsSubheading}</p>
      <Reviews />
    </section>

    <!-- Sección Ubicación & Mapa Google Maps -->
    {service.mapText && (
      <section class="find-us-section">
        <div class="box-map">
          <div class="info-map">
            <h2>How to Find Us</h2>
            <p set:html={service.mapText}></p>
            <p><i class="fa-solid fa-location-dot"><Icon name="location-dot" /></i> View on Google Maps <i class="fa-solid fa-arrow-right"><Icon name="arrow-right" /></i></p>
            {service.mapSubtext && <p set:html={service.mapSubtext}></p>}
            {service.mapCtaText && <a href={base + "contact"}>{service.mapCtaText}</a>}
          </div>
          <GoogleMap />
        </div>
      </section>
    )}

    <!-- FAQs del Servicio -->
    {service.faqs && service.faqs.length > 0 && (
      <section class="faqs-section">
        <div class="title-faqs">
          <h2>
            <i class="fa-solid fa-circle-question"><Icon name="circle-question" /></i> Frequently Asked Questions
          </h2>
        </div>
        <div class="items-faqs">
          <ol>
            {service.faqs.map(faq => (
              <li>
                <h3>
                  <strong set:html={faq.q}></strong><br />
                  <span set:html={faq.a}></span>
                </h3>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<!-- Script inline para procesamiento del formulario utilizando JavaScript nativo y grecaptcha -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function() {
    const submitBtn = document.getElementById("submit_button");
    if (submitBtn) {
      submitBtn.addEventListener("click", sendmail);
    }
  });

  function sendmail(event) {
    if (event) event.preventDefault();
    
    const aceptCheck = document.getElementById("acept");
    if (aceptCheck && !aceptCheck.checked) {
      alert("Please accept the Privacy Policy.");
      return false;
    }
    
    var captchaResponse = typeof grecaptcha !== "undefined" ? grecaptcha.getResponse() : "";
    if (!captchaResponse) {
      alert("Please verify the reCAPTCHA.");
      return false;
    }

    const submitBtn = document.getElementById("submit_button");
    const loaderEl = document.getElementById("load_form");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "SENDING...";
    }
    if (loaderEl) {
      loaderEl.style.display = "block";
    }

    const nameVal = document.getElementById("name")?.value || "";
    const lastNameVal = document.getElementById("lastName")?.value || "";
    const phoneVal = document.getElementById("phone")?.value || "";
    const emailVal = document.getElementById("email")?.value || "";
    const messageVal = document.getElementById("message")?.value || "";

    var formData = {
      name: nameVal,
      lastName: lastNameVal,
      phone: phoneVal,
      email: emailVal,
      message: messageVal,
      "g-recaptcha-response": captchaResponse
    };

    // Envío principal al script PHP ubicado en la ruta absoluta
    const contactForm = document.getElementById("contact_form_id");
    var base = contactForm ? (contactForm.getAttribute("data-base") || "/") : "/";
    
    var urlParams = new URLSearchParams(formData);

    fetch(base + "sendmail/send_contact.php", {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      body: urlParams
    })
    .then(response => response.text())
    .then(result => {
      if (loaderEl) loaderEl.style.display = "none";
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "SEND REQUEST";
      }

      try {
        var res = JSON.parse(result);
        if (res.success) {
          const msgBox = document.getElementById("message_box");
          if (msgBox) {
            msgBox.innerHTML = "<p style='color:#b71c1c; font-weight:700;'>Sent successfully!</p>";
            msgBox.style.display = "block";
          }
          if (contactForm) {
            contactForm.reset();
          }
          grecaptcha.reset();
        } else {
          alert(res.message || "Error");
          grecaptcha.reset();
        }
      } catch (e) {
        alert("Sent, but check server response.");
      }
    })
    .catch(err => {
      if (loaderEl) loaderEl.style.display = "none";
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "SEND REQUEST";
      }
      alert("An error occurred during submission.");
    });
  }
</script>
