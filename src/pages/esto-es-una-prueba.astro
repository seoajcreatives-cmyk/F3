<style>
  .test-banner {
    position: relative;
    width: 100%;
    height: 40vh;
    min-height: 300px;
    background: linear-gradient(135deg, #1a1a1a 0%, #e31e24 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .test-banner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .test-banner-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    padding: 0 5%;
  }

  .test-banner-content h1 {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .test-banner-content p {
    font-size: 18px;
    font-weight: 400;
    opacity: 0.9;
  }

  .test-content {
    padding: 60px 5%;
    background: #fff;
  }

  .test-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .test-block {
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid #eee;
  }

  .test-block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .test-block h2 {
    font-size: 26px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .test-block p {
    font-size: 16px;
    line-height: 1.8;
    color: #555;
    margin-bottom: 14px;
  }

  .test-block p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .test-banner-content h1 {
      font-size: 28px;
    }

    .test-banner-content p {
      font-size: 15px;
    }

    .test-block h2 {
      font-size: 22px;
    }
  }
</style>
