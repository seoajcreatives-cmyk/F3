---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<div class="cookie-banner" id="cookieBanner">
  <div class="cookie-container">
    <div class="aj-cookie-text" id="ajCookieDesc">
      <strong>We value your privacy</strong>
      We use cookies to run this site, analyze traffic, and measure marketing. See our 
      <a href={`${base}privacy`}>Privacy Policy</a> and 
      <a href={`${base}terms`}>Terms &amp; Conditions</a>.
    </div>
    <div class="cookie-buttons">
      <button id="acceptCookies" class="accept-btn">Accept</button>
      <button id="rejectCookies" class="reject-btn">Reject Non-Essential</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: #000;
    color: #fff;
    padding: 15px 20px;
    border-radius: 8px;
    z-index: 9999;
    display: none;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  }
  .cookie-banner.show {
    display: block;
    animation: slideUp 0.3s ease-out;
  }
  .cookie-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  /* Modifica la regla del <strong> dentro de .aj-cookie-text */
  .aj-cookie-text strong {
    display: block;
    font-family: "Unbounded", 'Poppins', Arial, sans-serif;
    font-weight: 600;
    font-size: 13px;           /* Increased font size */
    line-height: 1;
    text-transform: none;      /* Cambiado de uppercase a Normal/Title Case */
    letter-spacing: 0;
    margin-bottom: 4px;
    color: #ffffff;
  }
  .aj-cookie-text {
    flex: 1 1 auto;
    align-self: center;
    font-size: 13px;         /* Increased font size */
    line-height: 1.35;
    letter-spacing: 0;
    font-stretch: 87.5%;
    overflow: hidden;
  }
  .aj-cookie-text a {
    color: var(--red, #e31e24);
    text-decoration: underline;
  }
  .cookie-buttons {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .accept-btn {
    background: var(--red, #e31e24);
    color: #fff;
    border: none;
    padding: 8px 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .accept-btn:hover {
    opacity: 0.9;
  }
  .reject-btn {
    background: transparent;
    color: #fff;
    border: 1px solid #fff;
    padding: 8px 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .reject-btn:hover {
    background: #fff;
    color: #000;
  }

  @keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (max-width: 768px) {
    .cookie-banner {
      bottom: 0;
      left: 0;
      right: 0;
      border-radius: 0;
      padding: 15px;
    }
    .cookie-container {
      flex-direction: column;
      align-items: flex-start;
    }
    .cookie-buttons {
      width: 100%;
    }
    .accept-btn,
    .reject-btn {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('cookieBanner');
    const acceptBtn = document.getElementById('acceptCookies');
    const rejectBtn = document.getElementById('rejectCookies');

    if (!banner || !acceptBtn) return;

    // Check if user already made a choice
    const hasChosen = localStorage.getItem('f3_cookiesAccepted');

    if (!hasChosen) {
      // Show banner if no choice yet
      setTimeout(() => {
        banner.classList.add('show');
      }, 500); // slight delay before showing
    }

    acceptBtn.addEventListener('click', () => {
      localStorage.setItem('f3_cookiesAccepted', 'true');
      banner.classList.remove('show');
    });

    rejectBtn?.addEventListener('click', () => {
      localStorage.setItem('f3_cookiesAccepted', 'rejected');
      banner.classList.remove('show');
    });
  });
</script>
