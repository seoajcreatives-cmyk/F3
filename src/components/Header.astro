---
// src/components/Header.astro
import { Image } from 'astro:assets';
import bbbLogo from '../../public/media/png/acreditation-f3-2.png';
import bbbLogoMobile from '../../public/media/png/acreditation-f3-2-1.png';
import logoImg from '../../public/media/webp/png/logo.webp';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<header>
  <div class="line-address">
    <a href="https://goo.gl/maps/2JWRRVgKfv4YvGaCA" target="_blank"><Icon name="location-dot" /><span>290 Earle St. Central Islip, NY 11722</span></a>
    <a href="tel:+16312788693"><Icon name="phone" /><span>631-278-8693</span></a>
    <a href="mailto:f3construction@gmail.com"><Icon name="envelope" /><span>f3construction@gmail.com</span></a>
    <div class="social-icon">
      <a class="btn_social" href="https://www.facebook.com/f3construction/" target="_blank" aria-label="Facebook"><Icon name="facebook-f" /></a>
      <a class="btn_social" href="https://www.tiktok.com/@f3construction_ny" target="_blank" aria-label="tiktok"><Icon name="tiktok" /></a>
      <a class="btn_social" href="https://www.instagram.com/f3constructionny?igsh=dTZ2cTZ4NXp2aHRt" target="_blank" aria-label="instagram"><Icon name="instagram" /></a>
      <a class="btn_social" href="https://www.google.com/search?hl=en&authuser=0&gl=co&output=search&q=F3+Construction+Corp&ludocid=4353299437963021024&gsas=1&lsig=AB86z5Uhqch1JIsGnD4QLuWF2d_2&ved=1i%3A2%2Ct%3A109124%2Ce%3A1%2Cp%3AZmLZY8WEOZ6BkvQPiICT8Ac%3A1" target="_blank" aria-label="gmb"><Icon name="google" /></a>
      <a class="btn_social" href="https://yelp.com/biz/f3-construction-central-islip" target="_blank" aria-label="yelp"><Icon name="yelp" /></a>
    </div>
  </div>
  
  <div class="header-desktop">
    <div class="header-left">
      <div class="logo" style="width: 160px; height: 109px; flex-shrink: 0; display: block;">
        <a href={base} aria-label="F3 Construction Logo" style="display: block; width: 100%; height: 100%;">
          <Image class="primary-logo" 
                 src={logoImg} 
                 alt="F3 Construction" 
                 widths={[120, 160, 240, 320]}
                 sizes="(max-width: 996px) 120px, 160px"
                 format="webp"
                 quality={85}
                 style="width: 100%; height: auto; display: block; aspect-ratio: 300 / 205;"
                 loading="eager"
                 fetchpriority="high" />
        </a>
      </div>
      <div class="menu">
        <ul>
          <li><a href={base}>Home</a></li>

          <li class="dropdown">
            <a href={base + "about"}>About Us <Icon name="angle-down" /></a>
            <ul class="dropdown-menu about-menu">
              <li><a href={base + "reviews"}>Reviews</a></li>
            </ul>
          </li>

          <li class="dropdown">
            <a href={base + "services"}>Services <Icon name="angle-down" /></a>
            <ul class="dropdown-menu services-menu">
              <li class="has-sub">
                <span class="sub-cat">Interior Renovation Contractor <Icon name="angle-down" class="sub-arrow" /></span>
                <ul class="submenu">
                  <li><a href={base + "services/basement-solutions-long-island-ny"}>Basement Solutions</a></li>
                  <li><a href={base + "services/kitchen-remodeling-long-island-ny"}>Kitchen Renovation</a></li>
                  <li><a href={base + "services/bathroom-renovation-long-island-ny"}>Bathroom Renovation</a></li>
                  <li><a href={base + "services/trim-carpentry-services-long-island-ny"}>Trim Carpentry</a></li>
                  <li><a href={base + "services/crown-molding-long-island-ny"}>Crown Molding</a></li>
                </ul>
              </li>
              <li class="has-sub">
                <span class="sub-cat">Exterior Improvements Contractor <Icon name="angle-down" class="sub-arrow" /></span>
                <ul class="submenu">
                  <li><a href={base + "services/siding-installation-long-island-ny"}>Siding Installation</a></li>
                  <li><a href={base + "services/replacement-windows-long-island-ny"}>Replacement Windows</a></li>
                  <li><a href={base + "services/door-installation-long-island-ny"}>Door Installation</a></li>
                  <li><a href={base + "services/house-painting-long-island-ny"}>House Painting</a></li>
                  <li><a href={base + "services/power-washing-long-island-ny"}>Power Washing</a></li>
                </ul>
              </li>
              <li class="has-sub">
                <span class="sub-cat">Outdoor Structures Builder <Icon name="angle-down" class="sub-arrow" /></span>
                <ul class="submenu">
                  <li><a href={base + "services/garage-builder-long-island-ny"}>Garage Builders</a></li>
                  <li><a href={base + "services/masonry-contractors-long-island-ny"}>Masonry Contractors</a></li>
                  <li><a href={base + "services/deck-builders-long-island-ny"}>Deck Builders</a></li>
                  <li><a href={base + "services/portico-contractor-long-island-ny"}>Portico Contractor</a></li>
                  <li><a href={base + "services/tile-installation-service-long-island-ny"}>Tile Installation</a></li>
                </ul>
              </li>
              <li class="has-sub">
                <span class="sub-cat">Patio Installer <Icon name="angle-down" class="sub-arrow" /></span>
                <ul class="submenu">
                  <li><a href={base + "services/patio-contractor-long-island-ny"}>Paver Patio Installation</a></li>
                </ul>
              </li>
            </ul>
          </li>

          <li><a href={base + "gallery"}>Gallery</a></li>
          <li><a href={base + "contact"}>Contact</a></li>

          <li class="dropdown">
            <a href="/blog">Blog <Icon name="angle-down" /></a>
            <ul class="dropdown-menu">
              <li><a href="https://f3constructionny.com/blog/category/kitchen-renovation-guides/">Kitchen Renovation Guides</a></li>
              <li><a href="https://f3constructionny.com/blog/category/deck-construction-insights/">Deck Construction Insights</a></li>
              <li><a href="https://f3constructionny.com/blog/category/crown-molding-resources/">Crown Molding Resources</a></li>
              <li><a href="https://f3constructionny.com/blog/category/portico-style-inspiration/">Portico Style Inspiration</a></li>
              <li><a href="https://f3constructionny.com/blog/category/tile-remodeling-ideas/">Tile Remodeling Ideas</a></li>
              <li><a href="https://f3constructionny.com/blog/category/home-siding-improvement/">Home Siding Improvement</a></li>
              <li><a href="https://f3constructionny.com/blog/category/bath-remodeling-tips/">Bath Remodeling Tips</a></li>
              <li><a href="https://f3constructionny.com/blog/category/masonry-craftsmanship-tutorials/">Masonry Craftsmanship Tutorials</a></li>
            </ul>
          </li>
        </ul>
      </div>
      
      <div class="bbb-logo" style="width: 150px; height: 57px; flex-shrink: 0; display: block;">
        <a href="https://www.bbb.org/us/ny/central-islip/profile/home-improvement/f3-constructions-corp-0121-87182765" style="display: block; width: 100%; height: 100%;">
          <Image src={bbbLogo} alt="BBB" width={150} height={57} format="webp" quality={85} style="width: 100%; height: auto; display: block; aspect-ratio: 150 / 57;" />
        </a>
      </div>
    </div>

    <div class="header-right">
      <div class="contact-button">
        <a href={base + "contact"}>Free Quote Service</a>
      </div>
    </div>
  </div>

  <div class="mobile-header" id="mobile-header">
    <div class="mobile-header-container">
      <div style="width: 120px; aspect-ratio: 300 / 205; flex-shrink: 0; overflow: hidden; display: block;">
        <a href={base} aria-label="logo" style="display: block; width: 100%; height: 100%;">
          <Image class="primary-logo" 
                 src={logoImg} 
                 alt="F3 Construction" 
                 widths={[120, 160, 240, 320]}
                 sizes="(max-width: 996px) 120px, 160px"
                 format="webp"
                 quality={85}
                 style="width: 100%; height: auto; display: block; aspect-ratio: 300 / 205; object-fit: contain;"
                 loading="eager"
                 fetchpriority="high" />
        </a>
      </div>
      <div class="mobile_toggle">
        <hr />
        <hr />
        <hr />
      </div>
      <div class="mobile_blur"></div>

      <div class="side-bar-box">
        <ul class="menu">
          <li><a href={base}> Home</a></li>
          <li><a href={base + "about"}> About Us</a></li>

          <li class="dropdown">
            <p class="about-toggle"><Icon name="angle-down" /></p>
            <ul class="dropdown-menu about-menu">
              <li><a href={base + "reviews"}>Reviews</a></li>
            </ul>
          </li>

          <li><a href={base + "services"}>Services</a></li>

          <li class="dropdown">
            <p class="services-toggle"><Icon name="angle-down" /></p>
            <ul class="dropdown-menu services-menu">
              <li class="has-sub">
                <span class="sub-cat">Interior Renovation Contractor</span>
                <ul class="submenu">
                  <li><a href={base + "services/basement-solutions-long-island-ny"}>Basement Solutions</a></li>
                  <li><a href={base + "services/kitchen-remodeling-long-island-ny"}>Kitchen Renovation</a></li>
                  <li><a href={base + "services/bathroom-renovation-long-island-ny"}>Bathroom Renovation</a></li>
                  <li><a href={base + "services/trim-carpentry-services-long-island-ny"}>Trim Carpentry</a></li>
                  <li><a href={base + "services/crown-molding-long-island-ny"}>Crown Molding</a></li>
                </ul>
              </li>
              <li class="has-sub">
                <span class="sub-cat">Exterior Improvements Contractor</span>
                <ul class="submenu">
                  <li><a href={base + "services/siding-installation-long-island-ny"}>Siding Installation</a></li>
                  <li><a href={base + "services/replacement-windows-long-island-ny"}>Replacement Windows</a></li>
                  <li><a href={base + "services/door-installation-long-island-ny"}>Door Installation</a></li>
                  <li><a href={base + "services/house-painting-long-island-ny"}>House Painting</a></li>
                  <li><a href={base + "services/power-washing-long-island-ny"}>Power Washing</a></li>
                </ul>
              </li>
              <li class="has-sub">
                <span class="sub-cat">Outdoor Structures Builder</span>
                <ul class="submenu">
                  <li><a href={base + "services/garage-builder-long-island-ny"}>Garage Builders</a></li>
                  <li><a href={base + "services/masonry-contractors-long-island-ny"}>Masonry Contractors</a></li>
                  <li><a href={base + "services/deck-builders-long-island-ny"}>Deck Builders</a></li>
                  <li><a href={base + "services/portico-contractor-long-island-ny"}>Portico Contractor</a></li>
                  <li><a href={base + "services/tile-installation-service-long-island-ny"}>Tile Installation</a></li>
                </ul>
              </li>
              <li class="has-sub">
                <span class="sub-cat">Patio Installer</span>
                <ul class="submenu">
                  <li><a href={base + "services/patio-contractor-long-island-ny"}>Paver Patio Installation</a></li>
                </ul>
              </li>
            </ul>
          </li>

          <li><a href={base + "gallery"}> Gallery</a></li>
          <li><a href={base + "contact"}> Contact</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>

        <a href="https://www.bbb.org/us/ny/central-islip/profile/home-improvement/f3-constructions-corp-0121-87182765">
          <Image src={bbbLogoMobile} alt="BBB" width={150} height={57} format="webp" quality={85} style="width: 100%; height: auto;" />
        </a>

        <div class="button-header-mobile">
          <a class="btn_social" href="https://www.facebook.com/f3construction/" target="_blank" aria-label="Facebook"><Icon name="facebook-f" /></a>
          <a class="btn_social" href="https://www.tiktok.com/@f3ccorp" target="_blank" aria-label="tiktok"><Icon name="tiktok" /></a>
          <a class="btn_social" href="https://www.instagram.com/f3ccorp/" target="_blank" aria-label="instagram"><Icon name="instagram" /></a>
          <a class="btn_social" href="https://www.google.com/search?hl=en&authuser=0&gl=co&output=search&q=F3+Construction+Corp&ludocid=4353299437963021024&gsas=1&lsig=AB86z5Uhqch1JIsGnD4QLuWF2d_2&ved=1i%3A2%2Ct%3A109124%2Ce%3A1%2Cp%3AZmLZY8WEOZ6BkvQPiICT8Ac%3A1" target="_blank" aria-label="gmb"><Icon name="google" /></a>
          <a class="btn_social" href="https://yelp.com/biz/f3-construction-central-islip" target="_blank" aria-label="yelp"><Icon name="yelp" /></a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function active_toggle() {
    document.querySelector("#mobile-header")?.classList.toggle("toggle_active");
    document.querySelector(".mobile_toggle")?.classList.toggle("close_toggle");
  }

  document.querySelector(".mobile_toggle")?.addEventListener("click", active_toggle);
  document.querySelector(".mobile_blur")?.addEventListener("click", active_toggle);

  // Toggle de submenús en móvil (Services y About Us): abre/cierra al tocar la flecha
  document.querySelectorAll(".services-toggle, .about-toggle").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.currentTarget.closest(".dropdown")?.classList.toggle("open");
    });
  });
</script>
