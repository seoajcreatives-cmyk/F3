# ========================================================
# BITÁCORA PRIVADA - ACCESO DENEGADO
# Protegido contra bots de búsqueda (Googlebot, Bing, etc.)
# y visitantes externos de Internet.
# Compatible con Apache / LiteSpeed (Hostinger, GoDaddy, Netfirms)
# ========================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Forzar 404 (Not Found) para ocultar la existencia de la carpeta
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^.*$ - [R=404,L]
</IfModule>
